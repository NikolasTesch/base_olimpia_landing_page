---
import Heading from './SectionHeading.astro';import {selectUpcomingEvents,getEventStatusLabel,canRegister} from '../domain/content';const {content}=Astro.props;const {dated,pendingDate}=selectUpcomingEvents(content.events,new Date());
---
<section id="participar" class="dark"><div class="container"><div class="intro-grid"><Heading eyebrow="06 / SEU LUGAR NO TIME" title={content.title}/><p class="lead">{content.description}</p></div><h3 class="agenda-title">Próximos encontros</h3>{dated.length+pendingDate.length ? <div class="agenda">{[...dated,...pendingDate].map(e=><article class="event-row"><div class="event-date">{e.startsAt ? <time datetime={e.startsAt}>{new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'short',timeZone:'America/Sao_Paulo'}).format(new Date(e.startsAt))}</time> : 'Data a confirmar'}</div><div><span class="eyebrow">{e.type==='tryout'?'Peneira':'Jogo'}</span><h3>{e.title}</h3><p>{e.location ?? 'Local a confirmar'}</p></div><span class="status">{getEventStatusLabel(e)}</span>{canRegister(e) && <a class="button" href={e.contactUrl}>Inscrever-se</a>}</article>)}</div> : <p>{content.emptyAgenda}</p>}<p class="muted-light">{content.noOpenTryout}</p></div></section>
