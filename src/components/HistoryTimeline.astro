---
import Heading from './SectionHeading.astro';
import Media from './MediaPlaceholder.astro';
import { getPublicMilestones } from '../domain/content';
const { content } = Astro.props;
---
<section id="historia" class="dark">
  <div class="container">
    <Heading eyebrow="02 / NOSSA HISTÓRIA" title={content.title} description={content.description} />
    <div class="history-grid">
      <Media
        label="Memórias que construímos juntos"
        ratio="landscape"
        src={content.imageSrc}
        alt={content.imageSrc ? 'Memórias e treinos do projeto BASE' : undefined}
      />
      <div class="timeline" data-timeline>
        <span class="timeline-progress" data-timeline-progress aria-hidden="true"></span>
        {getPublicMilestones(content.milestones).map((m) => (
          <article data-timeline-item>
            <span class="timeline-dot" aria-hidden="true"></span>
            {m.date && <small>{m.date}</small>}
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="impact">
      <h3>{content.impact.title}</h3>
      <p>{content.impact.body}</p>
    </div>
  </div>
</section>
