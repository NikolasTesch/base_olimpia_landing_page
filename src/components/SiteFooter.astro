---
const { contact } = Astro.props;

const navGroups = [
  {
    title: 'Projeto',
    links: [
      { label: 'O Projeto', href: '#projeto' },
      { label: 'Nossa História', href: '#historia' },
      { label: 'Comissão Técnica', href: '#comissao' },
      { label: 'Equipes & Atletas', href: '#equipes' },
    ],
  },
  {
    title: 'Esportivo',
    links: [
      { label: 'Competições', href: '#competicoes' },
      { label: 'Resultados', href: '#resultados' },
      { label: 'Agenda & Peneiras', href: '#participar' },
      { label: 'O Dia a Dia', href: '#instagram' },
    ],
  },
  {
    title: 'Institucional',
    links: [
      { label: 'Apoiadores', href: '#apoiadores' },
      { label: 'Fale com a Base', href: '#contato' },
      { label: 'Colatina — ES', href: '#inicio' },
    ],
  },
];

const contacts = [
  {
    type: 'whatsapp',
    label: 'WhatsApp',
    value: '55 27 99728-2733',
    href: contact?.whatsappUrl ?? 'https://wa.me/5527997282733',
    external: true,
  },
  {
    type: 'phone',
    label: 'Telefone',
    value: '55 27 99728-2733',
    href: contact?.phone ? `tel:${contact.phone.replace(/[^+\d]/g, '')}` : 'tel:+5527997282733',
    external: false,
  },
  {
    type: 'instagram',
    label: 'Instagram',
    value: '@baseolimpiavolei',
    href: contact?.instagramUrl ?? 'https://www.instagram.com/baseolimpiavolei/',
    external: true,
  },
  {
    type: 'instagram',
    label: 'Feminino',
    value: '@baseolimpiavoleifeminino',
    href: contact?.instagramFemininoUrl ?? 'https://www.instagram.com/baseolimpiavoleifeminino/',
    external: true,
  },
];
---
<footer id="contato" class="site-footer">
  <div class="container footer-container">
    {/* Navigation Columns in LangChain style */}
    <div class="footer-nav-grid">
      {navGroups.map((group) => (
        <div class="footer-nav-group">
          <h3 class="footer-group-title">{group.title}</h3>
          <ul class="footer-links-list">
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Compact "Fale com o BASE" contact row */}
    <div class="footer-contact-compact" aria-label="Canais de contato">
      <div class="contact-compact-label">
        <span class="contact-dot" aria-hidden="true"></span>
        <span>Fale com a Base</span>
      </div>
      <div class="contact-pills-row">
        {contacts.map((item) => (
          <a
            href={item.href}
            class={`contact-chip contact-chip-${item.type}`}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-label={`${item.label}: ${item.value}`}
          >
            <span class="chip-icon" aria-hidden="true">
              {item.type === 'whatsapp' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.04 7.5C8.86 7.5 8.57 7.57 8.32 7.84C8.07 8.11 7.37 8.77 7.37 10.11C7.37 11.45 8.35 12.74 8.48 12.92C8.62 13.1 10.41 15.86 13.15 17.04C15.43 18.03 15.89 17.83 16.39 17.78C16.89 17.74 18 17.12 18.23 16.48C18.46 15.83 18.46 15.28 18.39 15.17C18.32 15.05 18.14 14.99 17.86 14.85C17.59 14.71 16.23 14.04 15.98 13.95C15.73 13.86 15.55 13.81 15.37 14.09C15.18 14.36 14.66 14.99 14.5 15.17C14.34 15.36 14.18 15.38 13.91 15.24C13.63 15.11 12.77 14.83 11.75 13.92C10.95 13.21 10.41 12.33 10.26 12.06C10.1 11.78 10.24 11.63 10.38 11.49C10.51 11.37 10.66 11.17 10.8 11.01C10.94 10.85 10.99 10.73 11.08 10.55C11.17 10.37 11.13 10.21 11.06 10.07C10.99 9.93 10.44 8.58 10.22 8.03C9.99 7.5 9.77 7.57 9.6 7.57C9.44 7.57 9.26 7.5 9.04 7.5Z"/>
                </svg>
              )}
              {item.type === 'phone' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              )}
              {item.type === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069M12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
            </span>
            <span class="chip-label">{item.label}</span>
            <span class="chip-value">{item.value}</span>
            {item.external && <span class="chip-arrow" aria-hidden="true">↗</span>}
          </a>
        ))}
      </div>
    </div>

    {/* Big Centralized Brand Statement (Uppercase, Real Logo Colors & Centered) */}
    <div class="footer-brand-statement" aria-label="Base Olímpia Vôlei Clube">
      <img
        src="/brand/escudo.png"
        width="112"
        height="112"
        alt="Escudo do Base Olímpia"
        class="footer-brand-crest"
      />
      <span class="footer-brand-title">BASE OLÍMPIA</span>
    </div>

    {/* Bottom Sub-footer bar */}
    <div class="footer-bottom-bar">
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Colatina, ES · Voleibol e Formação Cidadã</span>
      </div>
      <div class="footer-copyright">
        <span>© 2026 Base Olímpia Vôlei Clube</span>
      </div>
    </div>
  </div>
</footer>
