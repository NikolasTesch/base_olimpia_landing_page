---
import MediaPlaceholder from './MediaPlaceholder.astro';
const { content } = Astro.props;
---
<section id="inicio" class="hero">
  <div class="hero-media">
    <MediaPlaceholder
      label="Imagem de abertura do BASE"
      ratio="wide"
      loading="eager"
      src={content.posterSrc}
      alt={content.posterSrc ? 'Imagem de abertura do projeto BASE' : undefined}
    />
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="eyebrow">ESPORTE QUE TRANSFORMA</span>
      <h1>{content.title}</h1>
      <p>{content.description}</p>
      <div class="hero-actions">
        <a class="button" href={content.primaryAction.href}>{content.primaryAction.label}<span aria-hidden="true">↗</span></a>
        {content.storyVideoSrc && (
          <details class="hero-video">
            <summary>Assistir ao vídeo completo <span aria-hidden="true">▶</span></summary>
            <video controls preload="none" poster={content.posterSrc ?? undefined}>
              <source src={content.storyVideoSrc} />
              {content.storyCaptionsSrc && <track kind="captions" src={content.storyCaptionsSrc} srclang="pt-BR" label="Português" default />}
              Seu navegador não suporta este vídeo.
            </video>
          </details>
        )}
      </div>
      <div class="hero-footnote"><span aria-hidden="true">↓</span> Uma história construída em equipe</div>
    </div>
  </div>
</section>
