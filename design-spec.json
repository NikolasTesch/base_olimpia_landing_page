  "contracts": {
    "StaffMember": {
      "fields": [
        "id",
        "name",
        "role",
        "bio",
        "photoSrc",
        "status"
      ],
      "rules": [
        "Não inventar credenciais.",
        "Uma pessoa pode ter múltiplas funções."
      ]
    },
    "Milestone": {
      "fields": [
        "id",
        "title",
        "date",
        "body",
        "status"
      ],
      "rules": [
        "Data opcional.",
        "Não criar anos fictícios."
      ]
    },
    "Match": {
      "fields": [
        "id",
        "teamId",
        "opponent",
        "competition",
        "category",
        "startsAt",
        "state",
        "scoreSets",
        "setScores",
        "status"
      ],
      "states": [
        "scheduled",
        "completed",
        "postponed",
        "cancelled"
      ],
      "rules": [
        "Data ISO 8601 com fuso quando conhecida.",
        "Placar só para partida concluída com resultado confirmado.",
        "Parciais opcionais.",
        "Ordenar resultados confirmados por data decrescente."
      ]
    },
    "Event": {
      "fields": [
        "id",
        "type",
        "title",
        "startsAt",
        "location",
        "category",
        "state",
        "registrationState",
        "contactUrl",
        "status"
      ],
      "types": [
        "match",
        "tryout"
      ],
      "states": [
        "planned",
        "confirmed",
        "postponed",
        "cancelled"
      ],
      "registrationStates": [
        "open",
        "closed",
        "to-be-confirmed"
      ],
      "rules": [
        "Ordenar programação futura cronologicamente.",
        "Não anunciar inscrição aberta sem confirmação.",
        "Definir nova data para adiamento quando conhecida."
      ]
    },
    "Athlete": {
      "fields": [
        "id",
        "teamId",
        "name",
        "position",
        "photoSrc",
        "status"
      ],
      "rules": [
        "teamId deve existir.",
        "Não publicar dados pessoais desnecessários."
      ]
    },
    "InstagramPreview": {
      "fields": [
        "id",
        "title",
        "excerpt",
        "imageSrc",
        "permalink",
        "publishedAt",
        "status"
      ],
      "source": "manual-curation",
      "rules": [
        "Sem scraping ou tokens no frontend.",
        "Sem URL real, renderizar prévia não clicável com aviso.",
        "Não inventar likes ou comentários."
      ]
    }
